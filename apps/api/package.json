    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test"
  },
  "dependencies": {
    "@clickhouse/client": "^1.11.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
