    "@nestjs/platform-express": "^11.0.0",
    "@trace-ops/contracts": "workspace:*",
    "kafkajs": "^2.2.4",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.4",
    "typescript": "^5.8.3"
  }
}
