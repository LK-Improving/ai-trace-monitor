# Local development only. Replace these values before exposing services beyond localhost.
POSTGRES_USER=trace_ops
POSTGRES_PASSWORD=trace_ops_dev_only
POSTGRES_DB=trace_ops

DATABASE_URL=postgresql://trace_ops:trace_ops_dev_only@localhost:5432/trace_ops
API_PORT=3001
VITE_API_BASE_URL=/api/v1
# Required for project/service/key management routes. Leave unset to fail closed.
# Generate a private value locally; never expose it to the browser or commit it.
PLATFORM_ADMIN_TOKEN=

# Host-process connection. Containers should use kafka:29092 instead.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=ai-spans
# Bounded in-memory span queue. Accepted HTTP requests are not durable until Kafka acknowledges them.
SPAN_QUEUE_MAX_SPANS=5000
SPAN_QUEUE_MAX_BYTES=16777216
SPAN_QUEUE_BATCH_SIZE=100
SPAN_QUEUE_MAX_RETRIES=3

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=trace_ops
CLICKHOUSE_PASSWORD=trace_ops_dev_only
CLICKHOUSE_DATABASE=observability
CLICKHOUSE_TABLE=trace_spans
